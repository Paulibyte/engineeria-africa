# Engineeria Africa — settings. Copy is created as .env by "npm run setup".
# .env is never committed to git, so server-only settings live here (not in package.json).

NODE_ENV=production
PORT=4100
# Full public address of the site, no trailing slash
SITE_URL=https://engineeriaafrica.com

# First admin account — created automatically on first start
ADMIN_NAME=Engineeria Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Generated by "npm run setup" — keep secret
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Optional: live weather from openweathermap.org (free key). Leave blank to enter weather by hand.
OPENWEATHER_API_KEY=
